# MyCut 生产环境配置模板。
# 用法：复制为 .env.production 并按下面说明填写，然后 docker compose up -d --build。
# 注意：.env.production 已被 .gitignore / .dockerignore 排除，不会入库、不会进镜像。

# ================= 运行模式 =================
# 容器内用「桌面语义后台线程」执行任务，免 Redis（compose 已设 AUTOCLIP_DESKTOP_MODE=1）。
# 数据目录由 compose 挂持久卷到 /app/data。
ENVIRONMENT=production
DEBUG=false

# FFmpeg：容器内走系统 PATH（apt 装的 /usr/bin/ffmpeg），无需再写死路径。
# 若坚持指定可用：AUTOCLIP_FFMPEG_PATH=/usr/bin/ffmpeg

# ================= 数据库 =================
# 默认用 /app/data 下的 SQLite（单机单容器足够）。
DATABASE_URL=sqlite:///./data/autoclip.db
# 若将来上 Postgres（如 Supabase 自带库），改成：
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ================= LLM（DeepSeek，OpenAI 兼容）=================
# 推荐启动后在「设置页」填 key（存 /app/data/settings.json，随持久卷保留）；
# 也可在此用环境变量注入。
API_MODEL_NAME=qwen-plus
API_MAX_TOKENS=4096
API_TIMEOUT=30

# ================= 处理参数 =================
PROCESSING_CHUNK_SIZE=5000
PROCESSING_MIN_SCORE_THRESHOLD=0.7
PROCESSING_MAX_CLIPS_PER_COLLECTION=5
PROCESSING_MAX_RETRIES=3
LOG_LEVEL=INFO

# ================= CORS =================
# 同源部署（nginx 反代 /api，前后端同域）：留空即可，最安全。
# 前后端分离部署：填精确域名，逗号分隔，例如：
# CORS_ALLOW_ORIGINS=https://mycut.example.com,https://www.mycut.example.com
CORS_ALLOW_ORIGINS=

# ================= Supabase 认证（登录/注册）=================
# 要开登录，下面【前端 3 个】和【后端 3 个】都要配，且必须一起开，否则会出现
# 「前端要登录、后端不校验」或「前端根本不显示登录」的不一致。全留空 = 不启用登录，
# 任何人打开网页直接用（当前默认）。
#
# 前端（构建时注入，决定是否显示登录门；值是公开的 anon key，非机密）：
#   VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY 从 Supabase 控制台 Project Settings → API 拿。
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# 前后端分离部署才填后端域名；同源部署（nginx 反代）留空。
VITE_API_BASE_URL=
#
# 后端（校验前端传来的 token，决定 API 是否强制登录）：
#   SUPABASE_URL 走 JWKS 验签（新版 Supabase）；或 SUPABASE_JWT_SECRET 走 HS256（老项目）。
SUPABASE_URL=
SUPABASE_JWT_SECRET=
AUTH_ENABLED=false

# ---- 管理者后台 ----
# 逗号分隔的管理员邮箱白名单。用这些邮箱登录后可进 /admin 后台
# （用户与会员 / 订单流水 / 概览大盘，并可手动发放会员）。
# 留空 = 没有管理员，后台接口全拒。复用现有 Supabase 登录，无需额外账号。
ADMIN_EMAILS=

# ================= 支付宝支付 =================
# 前置：需企业/个体工商户资质并在开放平台签约「电脑网站支付」，个人号无法上生产。
# ALIPAY_ENABLED=false 时支付接口返回 503，不影响其它功能。
ALIPAY_ENABLED=false
ALIPAY_APP_ID=
# 生产网关（沙箱是 openapi-sandbox.dl.alipaydev.com）：
ALIPAY_SERVER_URL=https://openapi.alipay.com/gateway.do
ALIPAY_SIGN_TYPE=RSA2
# 密钥 PEM：放宿主机 ./secrets 下，compose 以只读卷挂到 /app/secrets。
ALIPAY_APP_PRIVATE_KEY_PATH=/app/secrets/alipay_app_private_key.pem
ALIPAY_PUBLIC_KEY_PATH=/app/secrets/alipay_public_key.pem
# 生产必须公网可达（支付宝异步通知发货）：
ALIPAY_NOTIFY_URL=https://mycut.example.com/api/v1/pay/alipay/notify
ALIPAY_RETURN_URL=https://mycut.example.com/#/membership
MEMBERSHIP_MONTH_PRICE=98.00

# ================= 成片资源控制（小内存服务器很重要）=================
# Remotion 渲染并发：每个并发 = 一个 headless Chromium（1080p 下每个吃 0.3~0.7G）。
# 2核4G 机器建议 2；4核8G 可设 3~4 加速；1G 小机可设 1。默认 2。
REMOTION_CONCURRENCY=2
# MiniMax 实拍并发（纯网络等待，几乎不吃 CPU/内存），默认 4：
# MINIMAX_CONCURRENCY=4

# ================= 成片外部服务（可选，不填自动降级）=================
# 空镜画面风格：minimax=实拍（默认）/ collage=半调纸拼贴组装动画（产品化自 gbro-collage-broll skill）
VIDEO_PROVIDER=minimax

# collage provider（VIDEO_PROVIDER=collage 时才用到）：拼贴静帧 + 首尾帧插值动画，强制无声、靠 TTS 旁白。
# 默认组合 = OpenRouter 出静帧 + MiniMax H3 出动画（复用下面 MiniMax 那一整套配置，不用额外账号）。
# 不用 Gemini 当默认的原因：它免费层对图像/Omni 视频是 limit: 0，不开计费出不来；
# 而 OpenRouter 只有图像模型、没有视频模型。key 不填则整条回退信息动画，成片仍产出。
OPENROUTER_API_KEY=
# COLLAGE_STILL_ENGINE=openrouter   # 或 gemini（直连，要开计费）
# COLLAGE_VIDEO_ENGINE=minimax      # 或 omni（Gemini Omni Flash，要开计费 + google-genai>=2.10.0）
# COLLAGE_IMAGE_MODEL=       # 留空按内置候选表依次试（openrouter 表以 google/ 开头）
# GEMINI_API_KEY=            # 只有切 gemini 静帧 / omni 动画时才需要
# COLLAGE_VIDEO_MODEL=gemini-omni-flash-preview   # 同上，仅 omni 引擎看
# COLLAGE_ASPECT=16:9        # 跟 Remotion 画布一致（skill 原版默认 9:16 竖屏）
# COLLAGE_DURATION=5         # minimax 引擎 4~15，omni 引擎 3~10，越界夹回
# COLLAGE_MAX_COST=5         # 需先设 COLLAGE_PRICE_PER_SECOND / COLLAGE_PRICE_PER_STILL

# MiniMax H3（实拍空镜）：只要密钥能出公网就能用，无需登录态；不填则整条回退信息动画，成片仍产出。
# 密钥在 platform.minimaxi.com → 账户管理 → 接口密钥。
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-H3
MINIMAX_REGION=cn          # cn=api.minimaxi.com；global=api.minimax.io（两站密钥不通用）
MINIMAX_RESOLUTION=768P    # 仅 768P（最省，1344×768）/ 2K
MINIMAX_DURATION=5         # 单段秒数，4~15
# H3 出片自带与画面同步的原生环境音，怎么用它：
#   mix (默认) TTS 旁白 + 原生音轨压低垫底；only 只用原生音轨、不做旁白；off 静音只留旁白
MINIMAX_AUDIO_MODE=mix
# MINIMAX_AUDIO_VOLUME=0.18  # mix 模式垫底音量 0~1
# MINIMAX_DISABLE=1        # 显式关闭实拍，全走信息动画
# 成本上限保护（先给单价，再给单条成片累计上限，单位自定但两者一致）：
# MINIMAX_PRICE_PER_SECOND=0.08
# MINIMAX_MAX_COST=5
