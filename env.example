# AutoClip 环境变量配置示例
# 复制此文件为 .env 并填入实际配置

# 数据库配置
DATABASE_URL=sqlite:///./data/autoclip.db

# Redis配置
REDIS_URL=redis://localhost:6379/0

# API配置
API_DASHSCOPE_API_KEY=your_dashscope_api_key_here
API_MODEL_NAME=qwen-plus
API_MAX_TOKENS=4096
API_TIMEOUT=30

# 处理配置
PROCESSING_CHUNK_SIZE=5000
PROCESSING_MIN_SCORE_THRESHOLD=0.7
PROCESSING_MAX_CLIPS_PER_COLLECTION=5
PROCESSING_MAX_RETRIES=3

# 路径配置（可选，系统会自动检测）
# PATH_PROJECT_ROOT=
# PATH_DATA_DIR=
# PATH_UPLOADS_DIR=
# PATH_TEMP_DIR=
# PATH_OUTPUT_DIR=

# 日志配置
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_FILE=backend.log

# 环境配置
ENVIRONMENT=development
DEBUG=true

# ---- 空镜画面风格（选哪个 provider 生成上区画面）----
#   minimax（默认）实拍级空镜，MiniMax H3，自带原生环境音
#   collage        半调纸拼贴组装动画（Gemini 静帧 + Omni Flash 首尾帧），强制无声、靠 TTS 旁白
#                  产品化自 gbro-collage-broll skill；注意它**没有 skill 那三个人工确认闸门**，
#                  隐喻/静帧错了会直接花钱，靠同句缓存 + COLLAGE_MAX_COST 兜底
VIDEO_PROVIDER=minimax
# 空镜并发生成数（纯网络等待），默认 4；旧名 MINIMAX_CONCURRENCY 仍然认
# VIDEO_CONCURRENCY=4

# ---- collage provider：半调纸拼贴空镜（VIDEO_PROVIDER=collage 时才用到）----
# 两段各有引擎可选，默认组合是 OpenRouter 出静帧 + MiniMax H3 首尾帧插值出动画。
# 为什么不默认用 Gemini：它的免费层对图像模型和 Omni 视频额度是 limit: 0，不开计费一张都出不来；
# 而 OpenRouter 有这些图像模型、却没有任何视频输出模型 —— 所以动画那段交给已经在付费的 MiniMax。
# key 一个都不填 = 拼贴整条自动降级为信息动画，成片仍能产出。
#
# 静帧引擎：openrouter（默认，只要填了下面这把 key）/ gemini（直连，要开计费）
# COLLAGE_STILL_ENGINE=openrouter
# OPENROUTER_API_KEY=sk-or-v1-xxxx
# 动画引擎：minimax（默认，复用下面 MiniMax 那一整套配置）/ omni（Gemini Omni Flash，要开计费）
# COLLAGE_VIDEO_ENGINE=minimax
# 静帧模型；留空按内置候选表依次试。两种引擎各有一张表（名字都核过）：
#   openrouter: google/gemini-3-pro-image → google/gemini-3.1-flash-image → google/gemini-2.5-flash-image
#   gemini 直连: gemini-3-pro-image → gemini-3.1-flash-image → gemini-2.5-flash-image
# COLLAGE_IMAGE_MODEL=
# 只有 COLLAGE_VIDEO_ENGINE=omni 时才看这两项（minimax 引擎用 GEMINI 之外的自己那套）
# GEMINI_API_KEY=
# COLLAGE_VIDEO_MODEL=gemini-omni-flash-preview
# 画面比例，默认 16:9（跟 Remotion 画布 1920×1080 一致；skill 原版默认是 9:16 竖屏）
# COLLAGE_ASPECT=16:9
# 单段秒数：minimax 引擎 4~15，omni 引擎 3~10，越界自动夹回
# COLLAGE_DURATION=5
# COLLAGE_DISABLE=1              # 显式关闭拼贴，全走信息动画
# COLLAGE_KEEP_FRAMES=1          # 保留中间的首帧/尾帧 PNG，排查画面问题时用
# 成本上限保护（先给单价，再给单条成片累计上限，单位自定但一致）：
# COLLAGE_PRICE_PER_STILL=0.03
# COLLAGE_PRICE_PER_SECOND=0.15
# COLLAGE_MAX_COST=5

# ---- MiniMax H3 文生视频（自动成片的实拍空镜来源）----
# 不填 = 实拍整条自动降级为信息动画，成片仍能产出。
# 密钥在 platform.minimaxi.com → 账户管理 → 接口密钥；也可写进 data/settings.json 的 minimax_api_key。
MINIMAX_API_KEY=
# 模型 id（开放平台上的名字，若报「模型不存在」按平台文档改这里）
MINIMAX_MODEL=MiniMax-H3
# cn=api.minimaxi.com（国内，默认）；global=api.minimax.io。两站密钥不通用！
MINIMAX_REGION=cn
# 分辨率仅 768P（默认，最省，实际 1344×768）/ 2K；单段秒数 4~15
MINIMAX_RESOLUTION=768P
MINIMAX_DURATION=5
# H3 出片自带一条与画面同步的原生立体声音轨（环境音/音效，不是把中文稿念出来）。怎么用它：
#   mix (默认) TTS 旁白 + 原生音轨压低垫底 —— 有解说也有现场感
#   only       不跑 TTS，只用原生音轨（成片没有人声解说，每句时长改按 MINIMAX_DURATION 排）
#   off        原生音轨静音，只留旁白（换模型前的老行为）
MINIMAX_AUDIO_MODE=mix
# mix 模式下的垫底音量 0~1，默认 0.18（only 模式恒为全量，除非在此显式指定）
# MINIMAX_AUDIO_VOLUME=0.18
# 并发生成数（纯网络等待，几乎不吃 CPU），默认 4
# MINIMAX_CONCURRENCY=4
# MINIMAX_DISABLE=1               # 显式关闭实拍，全走信息动画
# 成本上限保护：先给每输出秒的单价，再给单条成片的累计上限（单位自定，两者一致即可）
# MINIMAX_PRICE_PER_SECOND=0.08
# MINIMAX_MAX_COST=5
# MINIMAX_GROUP_ID=              # 仅当 files/retrieve 报缺 GroupId 时才填
# MINIMAX_BASE_URL=              # 走中转/代理时直接指定 API 根地址

# ---- Supabase 认证（后端校验前端传来的 JWT）----
# AUTH_ENABLED=true 且填了 SUPABASE_JWT_SECRET 时，projects 接口才强制登录并按用户隔离。
# 留空 / false：后端不强制登录，老数据归属到本地用户（本地调试）。
# JWT secret 在 Supabase 控制台 Project Settings → API → JWT Settings → JWT Secret。
SUPABASE_URL=
SUPABASE_JWT_SECRET=
AUTH_ENABLED=false

# ---- 管理者后台 ----
# 逗号分隔的管理员邮箱白名单，用这些邮箱登录后可进 /admin 后台（用户/会员/订单/大盘 + 手动发会员）。
# 留空 = 没有管理员，后台接口全拒。复用现有 Supabase 登录，无需额外账号。
ADMIN_EMAILS=

# ---- 支付宝支付（电脑网站支付 alipay.trade.page.pay）----
# ALIPAY_ENABLED=true 且 APPID/应用私钥/支付宝公钥齐全时才启用支付接口。
# 沙箱：open.alipay.com/develop/sandbox/app 拿 APPID、买家账号；自己生成密钥对，
#       上传应用公钥，换回支付宝公钥。网关用沙箱地址。
ALIPAY_ENABLED=false
ALIPAY_APP_ID=
ALIPAY_SERVER_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_SIGN_TYPE=RSA2
# 密钥推荐用文件路径（多行 PEM 不适合塞进单行 env）；也可用 *_KEY 直接填（换行写成 \n）。
ALIPAY_APP_PRIVATE_KEY_PATH=
ALIPAY_PUBLIC_KEY_PATH=
# ALIPAY_APP_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=
# 异步通知地址（必须公网可达；本地沙箱可用内网穿透，或先不填靠前端轮询兜底）
ALIPAY_NOTIFY_URL=
# 付款后浏览器同步跳回地址（仅展示用）
ALIPAY_RETURN_URL=
# 月会员单价（元）
MEMBERSHIP_MONTH_PRICE=98.00 